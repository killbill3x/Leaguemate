  <script>
    // Initial Standings Data Fallback
    var defaultStandings = [
      { rk: 1, name: "#1 Seed Contender 👑", owner: "League Manager", w: 11, l: 3, pf: 1842.6, pa: 1610.2 },
      { rk: 2, name: "Gridiron Elite", owner: "Team Joe", w: 10, l: 4, pf: 1795.0, pa: 1640.4 },
      { rk: 3, name: "Show Me The Money", owner: "Team Mario", w: 9, l: 5, pf: 1720.8, pa: 1605.1 },
      { rk: 4, name: "Touchdown Titans", owner: "Team Kenya", w: 8, l: 6, pf: 1680.4, pa: 1675.0 },
      { rk: 5, name: "Red Zone Raiders", owner: "Team DeAnthony", w: 7, l: 7, pf: 1610.2, pa: 1630.5 },
      { rk: 6, name: "The Blitz Brigade", owner: "Team Noah", w: 7, l: 7, pf: 1595.6, pa: 1620.0 },
      { rk: 7, name: "Any Given Sunday", owner: "Team Pushkar", w: 6, l: 8, pf: 1550.4, pa: 1590.2 },
      { rk: 8, name: "Endzone Extravaganza", owner: "Team Francisco", w: 5, l: 9, pf: 1510.0, pa: 1680.1 },
      { rk: 9, name: "Fantasy Flukes", owner: "Team Matt", w: 4, l: 10, pf: 1480.2, pa: 1710.0 },
      { rk: 10, name: "Barely Gettin Bye 💩", owner: "Will Allen (Left League / CPU)", w: 3, l: 11, pf: 1390.5, pa: 1780.4 }
    ];

    function renderStandings(teams) {
      var tbody = document.getElementById('standings-tbody');
      tbody.innerHTML = '';
      teams.forEach(function(t, idx) {
        var tr = document.createElement('tr');
        if (idx === 0) tr.className = 'champ-row';
        if (idx === teams.length - 1) tr.className = 'sacko-row';

        tr.innerHTML = `
          <td class="rk" style="${idx === 0 ? 'color:#eab308;' : (idx === teams.length - 1 ? 'color:#ef4444;' : '')}">${t.rk || (idx + 1)}</td>
          <td>
            <span class="team-name">${t.name}</span>
            <span class="owner-sub">${t.owner}</span>
          </td>
          <td class="num" style="font-weight:700;">${t.w}-${t.l}${t.t ? '-' + t.t : ''}</td>
          <td class="num">${Number(t.pf).toLocaleString('en-US', {minimumFractionDigits: 1, maximumFractionDigits: 1})}</td>
          <td class="num">${Number(t.pa).toLocaleString('en-US', {minimumFractionDigits: 1, maximumFractionDigits: 1})}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // ESPN SYNC FUNCTION
    async function syncESPN() {
      var leagueId = document.getElementById('espn-league-id').value.trim();
      var season = document.getElementById('espn-season').value.trim();

      if (!leagueId) {
        alert("Enter an ESPN League ID");
        return;
      }

      var espnUrl = `https://lm-api-reads.fantasy.espn.com/apis/v3/games/ffl/seasons/${season}/segments/0/leagues/${leagueId}?view=mTeam&view=mStandings&view=mSettings&view=mRoster`;
      var proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(espnUrl)}`;

      var status = document.getElementById('standings-status');
      status.innerText = "Syncing ESPN...";

      try {
        var res = await fetch(proxyUrl);
        if (!res.ok) throw new Error("Could not reach ESPN. Check league visibility.");
        var data = await res.json();

        if (!data.teams || data.teams.length === 0) {
          throw new Error("No teams found. Ensure league is viewable by public.");
        }

        // Map owners/members
        var memberMap = {};
        if (data.members) {
          data.members.forEach(function(m) {
            memberMap[m.id] = (m.firstName && m.lastName) ? `${m.firstName} ${m.lastName}` : (m.displayName || "Manager");
          });
        }

        // Parse and sort teams
        var parsed = data.teams.map(function(t) {
          var tName = t.name ? t.name : ((t.location || '') + ' ' + (t.nickname || '')).trim();
          var ownerName = (t.owners && memberMap[t.owners[0]]) ? memberMap[t.owners[0]] : "Manager";
          var rec = (t.record && t.record.overall) ? t.record.overall : { wins: 0, losses: 0, ties: 0, pointsFor: 0, pointsAgainst: 0 };
          return {
            name: tName || "Team " + t.id,
            owner: ownerName,
            w: rec.wins,
            l: rec.losses,
            t: rec.ties || 0,
            pf: rec.pointsFor,
            pa: rec.pointsAgainst,
            pct: rec.percentage || 0
          };
        });

        // Sort: Best win pct first, tiebreak on Points For
        parsed.sort(function(a, b) {
          if (b.pct !== a.pct) return b.pct - a.pct;
          return b.pf - a.pf;
        });

        // Add crowns & sackos
        parsed[0].name += " 👑";
        parsed[parsed.length - 1].name += " 💩";

        localStorage.setItem('shittalkers_espn_standings', JSON.stringify(parsed));
        document.getElementById('standings-header-text').innerText = `${season} Season Standings`;
        status.innerText = `Synced with ESPN League ${leagueId}`;
        renderStandings(parsed);
        alert(`Successfully synced ${parsed.length} teams from ESPN for ${season}!`);
        setTab('standings', document.querySelectorAll('.nav-btn')[0]);

      } catch (err) {
        alert("ESPN Sync Error: " + err.message + "\n\nTip: In ESPN League Settings -> Basic Settings, set 'Make League Viewable to Public' to Yes.");
        status.innerText = "Sync Failed (Using Cached/Default)";
      }
    }

    // Tabs
    function setTab(tabId, btn) {
      var contents = document.getElementsByClassName('tab-content');
      for (var i = 0; i < contents.length; i++) contents[i].classList.remove('active');
      var buttons = document.getElementsByClassName('nav-btn');
      for (var j = 0; j < buttons.length; j++) buttons[j].classList.remove('active');
      document.getElementById('tab-' + tabId).classList.add('active');
      if (btn) btn.classList.add('active');
    }

    // Positional filter
    function filterPos(pos, btn) {
      var pills = document.getElementsByClassName('pos-pill');
      for (var i = 0; i < pills.length; i++) pills[i].classList.remove('active');
      btn.classList.add('active');
      var items = document.getElementsByClassName('pos-item');
      for (var j = 0; j < items.length; j++) {
        items[j].style.display = (pos === 'all' || items[j].classList.contains(pos)) ? 'flex' : 'none';
      }
    }

    // Triple tap Easter Egg
    var tapCount = 0;
    var tapTimer = null;
    function triggerSecretAuth() {
      tapCount++;
      clearTimeout(tapTimer);
      tapTimer = setTimeout(function() { tapCount = 0; }, 1200);

      if (tapCount === 3) {
        tapCount = 0;
        var pass = prompt("Commissioner Access: Enter Password");
        if (pass === "commish") {
          document.getElementById('admin-nav-btn').style.display = 'block';
          alert("Commissioner Unlocked!");
          setTab('upload', document.getElementById('admin-nav-btn'));
        } else if (pass !== null) {
          alert("Incorrect password.");
        }
      }
    }

    // Upload & Receipts
    var currentImg = null;
    function previewScreenshot(event) {
      var file = event.target.files[0];
      if (file) {
        var reader = new FileReader();
        reader.onload = function(e) {
          currentImg = e.target.result;
          var img = document.getElementById('preview-img');
          img.src = currentImg;
          img.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    }

    function processUpload() {
      if (!currentImg) {
        alert("Select an image first!");
        return;
      }
      var notes = document.getElementById('upload-notes').value || 'No caption.';
      var category = document.getElementById('upload-type').value;

      var saved = JSON.parse(localStorage.getItem('shittalkers_receipts') || '[]');
      saved.unshift({
        category: category,
        notes: notes,
        img: currentImg,
        date: new Date().toLocaleDateString()
      });

      try {
        localStorage.setItem('shittalkers_receipts', JSON.stringify(saved));
        alert("Receipt saved!");
        currentImg = null;
        document.getElementById('file-picker').value = '';
        document.getElementById('preview-img').style.display = 'none';
        document.getElementById('upload-notes').value = '';
        loadReceipts();
      } catch(e) {
        alert("Image too large for browser storage.");
      }
    }

    function loadReceipts() {
      var container = document.getElementById('receipts-container');
      var saved = JSON.parse(localStorage.getItem('shittalkers_receipts') || '[]');
      if (saved.length === 0) {
        container.innerHTML = '<div style="font-size:12px; color:#64748b; text-align:center; padding:20px 0;">No receipts saved yet. Upload box scores or photos from Commish panel!</div>';
        return;
      }
      container.innerHTML = '';
      saved.forEach(function(item) {
        var div = document.createElement('div');
        div.className = 'receipt-item';
        div.innerHTML = `
          <div class="receipt-header"><span>${item.category}</span><span style="color:#94a3b8; font-size:10px;">${item.date}</span></div>
          <p style="font-size:12px; color:#cbd5e1; margin-top:4px;">${item.notes}</p>
          <img src="${item.img}" alt="Receipt">
        `;
        container.appendChild(div);
      });
    }

    // Startup
    window.onload = function() {
      var cachedStandings = localStorage.getItem('shittalkers_espn_standings');
      if (cachedStandings) {
        try {
          renderStandings(JSON.parse(cachedStandings));
          document.getElementById('standings-status').innerText = 'ESPN League 140046 (Cached)';
        } catch(e) {
          renderStandings(defaultStandings);
        }
      } else {
        renderStandings(defaultStandings);
      }
      loadReceipts();
    };
  </script>
</body>
</html>
