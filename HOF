<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>League of Extraordinary Sh!t Talkers - Hall of Fame</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: #0b0f19; color: #f1f5f9; padding-bottom: 60px; }
    header { background: #111827; border-bottom: 1px solid #1f2937; padding: 18px 14px; text-align: center; }
    
    .commish-badge { 
      display: inline-block; 
      background: #eab308; 
      color: #000; 
      font-size: 11px; 
      font-weight: 800; 
      padding: 3px 10px; 
      border-radius: 12px; 
      margin-bottom: 6px; 
      text-transform: uppercase; 
      cursor: pointer; 
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    
    h1 { font-size: 19px; font-weight: 900; color: #fff; }
    p.sub { font-size: 12px; color: #94a3b8; margin-top: 2px; }
    
    .nav-bar { display: flex; background: #1e293b; border-bottom: 1px solid #334155; overflow-x: auto; padding: 6px 8px; gap: 6px; }
    .nav-btn { background: #0f172a; border: 1px solid #334155; color: #94a3b8; padding: 8px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; flex-shrink: 0; }
    .nav-btn.active { background: #eab308; color: #000; border-color: #eab308; font-weight: 800; }
    #admin-nav-btn { display: none; background: #2563eb; color: #fff; border-color: #3b82f6; }

    .container { padding: 14px; max-width: 650px; margin: 0 auto; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .card { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
    .card-title { font-size: 15px; font-weight: 800; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; color: #f59e0b; }
    
    .punish-box { background: #450a0a; border: 1px solid #991b1b; border-radius: 8px; padding: 12px; margin-bottom: 14px; }
    .punish-box h3 { font-size: 13px; font-weight: 800; color: #fca5a5; }
    .punish-box p { font-size: 12px; color: #fecaca; margin-top: 4px; line-height: 1.4; }

    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { text-align: left; padding: 8px 4px; color: #64748b; font-size: 10px; text-transform: uppercase; border-bottom: 1px solid #334155; }
    td { padding: 9px 4px; border-bottom: 1px solid #1e293b; }
    tr:nth-child(even) { background-color: #0f172a; }
    .rk { width: 24px; font-weight: 800; color: #94a3b8; text-align: center; }
    .team-name { font-weight: 700; color: #fff; }
    .owner-sub { font-size: 10px; color: #94a3b8; display: block; }
    .num { text-align: right; font-variant-numeric: tabular-nums; }
    .champ-row { background: rgba(234, 179, 8, 0.08) !important; }
    .sacko-row { background: rgba(239, 68, 68, 0.12) !important; }

    .pos-filters { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 10px; }
    .pos-pill { background: #0f172a; border: 1px solid #334155; color: #94a3b8; font-size: 11px; font-weight: 700; padding: 5px 10px; border-radius: 14px; cursor: pointer; flex-shrink: 0; }
    .pos-pill.active { background: #eab308; color: #000; border-color: #eab308; }
    .record-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #334155; }
    .p-tag { font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-right: 6px; }
    .tag-qb { background: #ef4444; color: #fff; }
    .tag-rb { background: #3b82f6; color: #fff; }
    .tag-wr { background: #10b981; color: #fff; }
    .tag-te { background: #f59e0b; color: #fff; }
    .tag-dst { background: #8b5cf6; color: #fff; }
    .tag-k { background: #ec4899; color: #fff; }
    .p-name { font-size: 13px; font-weight: 700; color: #fff; }
    .p-meta { font-size: 11px; color: #94a3b8; margin-top: 2px; }
    .p-pts { font-size: 16px; font-weight: 900; color: #eab308; text-align: right; }
    .p-bonus { font-size: 9px; color: #38bdf8; display: block; text-align: right; }
    .rule-note { font-size: 11px; background: #0f172a; border-left: 3px solid #38bdf8; padding: 8px; border-radius: 4px; margin-bottom: 12px; color: #cbd5e1; }

    .receipt-item { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 10px; margin-bottom: 10px; }
    .receipt-item img { width: 100%; border-radius: 6px; margin-top: 8px; max-height: 380px; object-fit: contain; background: #000; }
    .receipt-header { display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: #eab308; }

    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 11px; font-weight: 700; color: #94a3b8; margin-bottom: 4px; text-transform: uppercase; }
    .form-control { width: 100%; padding: 10px; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #fff; font-size: 13px; }
    .btn-submit { width: 100%; padding: 12px; background: #2563eb; color: #fff; font-weight: 800; border: none; border-radius: 6px; cursor: pointer; margin-top: 8px; }
    .btn-espn { background: #cc0000; color: #fff; font-size: 14px; }
    .btn-espn:hover { background: #b30000; }
    #preview-img { width: 100%; max-height: 220px; object-fit: contain; margin-top: 10px; border-radius: 6px; display: none; }
  </style>
</head>
